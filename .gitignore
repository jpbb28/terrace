# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# photo pipeline (contain API keys or are regeneratable)
scripts/review.html
scripts/photo-results.json
scripts/sv-headings.json
scripts/hires-progress.json

# photos (hosted on Supabase Storage)
/public/photos/

# PWA generated files (next-pwa output — regenerated on build)
/public/sw.js
/public/sw.js.map
/public/workbox-*.js
/public/workbox-*.js.map
/public/worker-*.js
/public/worker-*.js.map
/public/swe-worker-*.js
/public/swe-worker-*.js.map

# other apps
/wheel_src
